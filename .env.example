# Required: HCB OAuth application credentials.
HCB_OAUTH_CLIENT_ID=
HCB_OAUTH_CLIENT_SECRET=
HCB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/hcb/callback

# Optional: defaults to https://hcb.hackclub.com
# HCB_API_BASE_URL=https://hcb.hackclub.com

# Optional: cache TTLs (in seconds unless noted)
# HCB_MEMBERS_CACHE_TTL=60
# HCB_TRANSACTION_CACHE_TTL=1800
# HCB_SINGLE_TRANSACTION_CACHE_TTL=86400

# Optional: how long a browser-driven drain may go without asking for its next
# page before the background job standing behind it finishes the walk instead.
# A page that is closing says so directly (navigator.sendBeacon -> POST
# .../transactions/handoff), so this only governs the cases where nothing got
# to say anything: a crashed tab, a killed browser, a closed laptop.
# HCB_STREAM_HEARTBEAT_TIMEOUT=90

# Optional: how long a drain's progress record may go un-advanced before it is
# reported as stalled rather than as live progress. Should stay comfortably
# above the time one HCB page takes, or a slow walk will be reported as a dead
# one.
# HCB_DRAIN_PROGRESS_STALE_AFTER=75

# Optional: extra hostnames this app answers to, comma-separated. Guards against
# Host header / DNS rebinding attacks in production, which matters here because
# the OAuth discovery documents are built from the request's host. Defaults to
# the host of HCB_OAUTH_REDIRECT_URI, so it only needs setting for additional
# names (a preview deploy, a tunnel).
# APP_HOST=steelyard.hackclub.com

# Optional: which transaction engine HCB should serve, sent as the
# X-HCB-Transaction-Engine header on every API call. Defaults to "ledger" (the
# new engine); set it empty to send no header and fall back to HCB's legacy one.
# HCB_TRANSACTION_ENGINE=ledger
