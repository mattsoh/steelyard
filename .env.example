# Required: HCB OAuth application credentials.
HCB_OAUTH_CLIENT_ID=
HCB_OAUTH_CLIENT_SECRET=
HCB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/hcb/callback

# Optional: defaults to https://hcb.hackclub.com
# HCB_API_BASE_URL=https://hcb.hackclub.com

# Optional: cache TTLs (in seconds unless noted)
# HCB_MEMBERS_CACHE_TTL=60
# HCB_TRANSACTION_CACHE_TTL=1800
# HCB_SINGLE_TRANSACTION_CACHE_TTL=86400

# Optional: how long the background task loading an organization may go without
# advancing its progress record before it is judged dead -- reported as stalled,
# and taken over (from the pages it had already fetched) by the next request
# that needs the organization. Should stay comfortably above the time one HCB
# page takes, or a slow walk will be treated as a dead one.
# HCB_DRAIN_PROGRESS_STALE_AFTER=75

# Optional: whether Puma runs the Solid Queue job worker itself. Defaults to on
# in production (every load of an organization is a job, so a server with no
# worker renders nothing) and off elsewhere. Set false to run bin/jobs separately.
# SOLID_QUEUE_IN_PUMA=true

# Optional: after a load task fails, how long the read paths wait before
# starting another on their own. Every open tab polls while it waits, so
# without this a failing HCB would be retried on every poll. An explicit
# "Retry" ignores it.
# HCB_TASK_FAILURE_BACKOFF=60

# Optional: how many lines of each organization's activity log (what every
# viewer sees in the Activity panel) are kept. One line per page of a walk,
# plus the checks around it.
# HCB_ACTIVITY_LOG_ENTRIES=300

# Optional: extra hostnames this app answers to, comma-separated. Guards against
# Host header / DNS rebinding attacks in production, which matters here because
# the OAuth discovery documents are built from the request's host. Defaults to
# the host of HCB_OAUTH_REDIRECT_URI, so it only needs setting for additional
# names (a preview deploy, a tunnel).
# APP_HOST=steelyard.hackclub.com

# Optional: which transaction engine HCB should serve, sent as the
# X-HCB-Transaction-Engine header on every API call. Defaults to "ledger" (the
# new engine); set it empty to send no header and fall back to HCB's legacy one.
# HCB_TRANSACTION_ENGINE=ledger
